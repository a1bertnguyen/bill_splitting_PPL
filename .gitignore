# ============================================================================
# SplitLang .gitignore — Security-First Secret & Artifact Exclusions
# ============================================================================

# Secrets & Environment Variables (NEVER commit secrets!)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json

# Python bytecode, virtualenvs, caches & test artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Local databases & dumps
data/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql.bak
dump.sql

# React / Vite / Node
frontend/node_modules/
frontend/dist/
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vite/

# Generated media & temp files
demo/*.mp4
*.log
*.tmp
.DS_Store
Thumbs.db

# IDE / Editor configs
.vscode/
.idea/
*.swp
*.swo

# Agent skills, local design specs & code-intelligence indexes
design.md
.claude/
.gitnexus/
.taste-skill/
AGENTS.md
CLAUDE.md
