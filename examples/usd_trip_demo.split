/*
 * SplitLang v2.0 USD Trip Demo — Tokyo Trip
 * Demonstrates $ literals, cent-exact rounding, set algebra, and assertions.
 */

workspace "Tokyo Trip" {
    currency: USD
}
reset
member add [linh, minh, tuan]

let jp_tax   = 8%
let izakaya_tip = 10%
let sake_drinkers = all - [minh]

expense "Airport Express" paid_by linh = $100 split equal(all) on 2026-11-26

expense "Ramen Dinner" {
    payer:  minh
    amount: $45.50 + $14.50
    split:  equal(all)
    tax:    10%
    tip:    15%
    date:   2026-11-26
}

bill "Izakaya Night" {
    payer: tuan
    date:  2026-11-26
    item "Yakitori Set" = $36 for all
    item "Sake Carafe"  = $24 for sake_drinkers
    item "Yuzu Soda"    = $6  for [minh]
    tax:   jp_tax
    tip:   izakaya_tip
}

assert balanced
query balances
query balance(minh)
settle
