/*
 * SplitLang v2.0 Demo Script — Saigon Weekend Outing (VND)
 * Demonstrates: workspace blocks, typed `let` bindings, set algebra (`all - [charlie]`),
 * reusable `rule` abstractions, inline & block expenses, itemized `bill`, `transfer ->`,
 * `assert balanced`, and `settle`.
 */

workspace "Saigon Weekend" {
    currency: VND
}
reset
member add [alice, bob, charlie, dave]

// Typed Symbol Table bindings
let vat      = 10%
let tip_rate = 5%
let beer     = 60k
let drinkers = all - [charlie]

// Reusable weighted split rule
rule host_weighted = ratio { alice: 2, bob: 1, charlie: 1, dave: 1 }

// 1. Inline expense with arithmetic precedence (* binds tighter than +)
expense "Grab & Parking" paid_by alice = 120k + 30k * 4 split equal(all) on 2026-11-26

// 2. Inline expense using set difference on members
expense "Specialty Coffee" paid_by bob = 180k split equal(all - [dave]) on 2026-11-26

// 3. Structured block expense — exact split
expense "Cinema Tickets" {
    payer:  charlie
    amount: 300k
    split:  exact { alice: 100k, bob: 80k, charlie: 60k, dave: 60k }
    date:   2026-11-26
}

// 4. Structured block expense — percentage split
expense "Karaoke Room" {
    payer:  dave
    amount: 500k
    split:  percent { alice: 30%, bob: 30%, charlie: 20%, dave: 20% }
    date:   2026-11-26
}

// 5. Structured block expense referencing reusable split rule
expense "Hotpot Dinner" {
    payer:    alice
    amount:   400k
    split:    host_weighted
    discount: 50k
    date:     2026-11-26
}

// 6. Block-structured Itemized Receipt using `let` variables & set algebra
bill "BBQ Night" {
    payer:    bob
    date:     2026-11-26
    item "Wagyu Beef Platter" = 480k     for all
    item "Craft Beer Tower"   = beer * 4 for drinkers
    item "Matcha Iced Tea"    = 60k      for [charlie]
    discount: 60k
    tax:      vat
    tip:      tip_rate
}

// 7. Explicit arrow repayment transfer
transfer dave -> alice = 100k note "partial payback" on 2026-11-26

// 8. Verify zero-sum ledger invariant & inspect environment/settlements
assert balanced
query env
query summary
query balances
settle
