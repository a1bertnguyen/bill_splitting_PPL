# ============================================================================
# SplitLang Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your real local values.
# NEVER commit `.env` to Git!
# ============================================================================

# Database backend: "mysql" (default for production/local MySQL) or "sqlite" (offline tests only)
DB_BACKEND=mysql

# Local MySQL 9.x connection (use the least-privilege `splitlang_app` user created by sql/init_mysql.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=splitlang_db
MYSQL_USER=splitlang_app
MYSQL_PASSWORD=REPLACE_WITH_STRONG_MYSQL_APP_PASSWORD

# Server-side cryptographic secrets (generate via: python scripts/generate_secrets.py)
# SECRET_KEY: 64+ hex chars for signing CSRF tokens & session integrity
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_SECRET
# DATA_ENCRYPTION_KEY: valid Fernet base64 key for encrypting sensitive DB fields at rest
DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Transport & Cookie Security
# Set FORCE_HTTPS=true and COOKIE_SECURE=true in production behind TLS/HTTPS!
# Keep false only for local HTTP development on http://127.0.0.1:8000
FORCE_HTTPS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12

# Strict CORS allowlist (comma-separated origins; no wildcard "*" with credentials)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Login rate limit & lockout
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=300
